      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT DISTINCT ON (greenhouse_id) greenhouse_id as \"Serre\", ROUND(current_soil_moisture::numeric, 1) as \"Humidité Actuelle (%)\", ROUND(predicted_moisture_60min::numeric, 1) as \"Prédit à +60min (%)\", CASE WHEN irrigation_recommended THEN '🚨 OUI (Irrigation Requise)' ELSE '✅ NON (Optimal)' END as \"Recommandation\", recommendation_message as \"Analyse Détaillée\", timestamp as \"Dernier Calcul\" FROM irrigation_predictions ORDER BY greenhouse_id, timestamp DESC;",
