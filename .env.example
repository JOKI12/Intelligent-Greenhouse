# ==============================================================================
# SERRE AGRICOLE INTELLIGENTE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Project
COMPOSE_PROJECT_NAME=serre-agricole

# Mosquitto MQTT
MQTT_PORT=1883
MQTT_WS_PORT=9001
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883

# Apache Kafka (KRaft)
KAFKA_BROKER_HOST=kafka
KAFKA_BROKER_PORT=9092
KAFKA_EXTERNAL_PORT=29092
KAFKA_TOPIC_MEASURES=mesures_serre
KAFKA_TOPIC_DLQ=mesures_serre_dlq

# MinIO S3 Lakehouse
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://minio:9000
S3_BUCKET=lakehouse

# PostgreSQL Serving & Metastore
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=greenhouse_db
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# OpenWeatherMap API
# Leave blank or set a valid key. The platform works in synthetic fallback mode when empty.
OPENWEATHER_API_KEY=
OPENWEATHER_CITY=Paris,FR

# Apache Airflow
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
